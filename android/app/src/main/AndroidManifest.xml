<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- V2 candidate: original Compose surface; V2 discovery and strong biometrics. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Restore LAN discovery permissions from the original Wi-Fi transport. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher_dark"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_dark"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rba"
        android:usesCleartextTraffic="false">
        <activity android:name=".ui.v2.V2MainActivity" android:exported="false" />
        <activity-alias
            android:name=".LauncherAuto"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_dark"
            android:targetActivity=".ui.v2.V2MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherLight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_light"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_light"
            android:targetActivity=".ui.v2.V2MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_dark"
            android:targetActivity=".ui.v2.V2MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherMaterial"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_material"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_material"
            android:targetActivity=".ui.v2.V2MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherScrcpy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_scrcpy"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_scrcpy"
            android:targetActivity=".ui.v2.V2MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity android:name=".ui.v2.V2NotificationActivity"
            android:exported="false" android:excludeFromRecents="true" />
        <service android:name=".service.V2BackgroundService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled mutually authenticated local-network listener for foreground authentication review." />
        </service>
    </application>
</manifest>
