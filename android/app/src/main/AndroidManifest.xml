<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- V2 candidate: manual TCP endpoint, strong biometrics and explicit listener. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher_dark"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_dark"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rba"
        android:usesCleartextTraffic="false">
        <activity android:name=".ui.v2.V2OperatorActivity" android:exported="false" />
        <activity-alias android:name=".V2Launcher" android:exported="true"
            android:targetActivity=".ui.v2.V2OperatorActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity android:name=".ui.v2.V2NotificationActivity"
            android:exported="false" android:excludeFromRecents="true" />
        <service android:name=".service.V2BackgroundService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled mutually authenticated local-network listener for foreground authentication review." />
        </service>
    </application>
</manifest>
