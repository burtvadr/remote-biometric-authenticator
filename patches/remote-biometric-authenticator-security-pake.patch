+/// Final pairing confirmation, emitted only after the device owner taps Allow.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PairingCommit {
+    pub session_id: Id,
+    /// B's RFC 9382 key confirmation; sent only after host proof and owner approval.
+    pub device_confirmation: [u8; 32],
+}
+
+impl PairingCommit {
+    pub fn to_payload(&self) -> Vec<u8> {
+        cbor::encode(&Value::map([
+            ("device_confirmation", Value::Bytes(self.device_confirmation.to_vec())),
+            ("session_id", Value::Bytes(self.session_id.0.to_vec())),
+        ]))
+    }
+
+    pub fn from_payload(payload: &[u8]) -> Result<Self> {
+        let v = cbor::decode_canonical(payload)
+            .map_err(|e| ProtocolError::BadRequest(format!("pairing_commit payload: {e}")))?;
+        let confirmation_bytes = req_bytes(&v, "device_confirmation")?;
+        if confirmation_bytes.len() != 32 {
+            return Err(ProtocolError::BadRequest("pairing_commit device_confirmation must be 32 bytes".into()));
+        }
+        let mut device_confirmation = [0u8; 32];
+        device_confirmation.copy_from_slice(confirmation_bytes);
+        Ok(Self { session_id: req_id(&v, "session_id")?, device_confirmation })
+    }
+}
+
+/// Host acknowledgement that a user-approved pairing was durably committed.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PairingCommitResult {
+    pub session_id: Id,
+    pub status: u64,
+    pub revocation_token: Option<[u8; 32]>,
+}
+
+impl PairingCommitResult {
+    pub fn to_payload(&self) -> Vec<u8> {
+        let mut entries = vec![
+            ("session_id", Value::Bytes(self.session_id.0.to_vec())),
+            ("status", Value::Uint(self.status)),
+        ];
+        if let Some(token) = self.revocation_token {
+            entries.push(("revocation_token", Value::Bytes(token.to_vec())));
+        }
+        cbor::encode(&Value::map(entries))
+    }
+
+    pub fn from_payload(payload: &[u8]) -> Result<Self> {
+        let v = cbor::decode_canonical(payload)
+            .map_err(|e| ProtocolError::BadRequest(format!("pairing_commit_result payload: {e}")))?;
+        let status = req_uint(&v, "status")?;
+        if status > 1 {
+            return Err(ProtocolError::BadRequest("pairing_commit_result status must be 0 or 1".into()));
+        }
+        let revocation_token = match v.get("revocation_token") {
+            Some(Value::Bytes(bytes)) if bytes.len() == 32 => {
+                let mut token = [0u8; 32];
+                token.copy_from_slice(bytes);
+                Some(token)
+            }
+            Some(_) => return Err(ProtocolError::BadRequest("revocation_token must be 32 bytes".into())),
+            None => None,
+        };
+        if status == 0 && revocation_token.is_none() {
+            return Err(ProtocolError::BadRequest(
+                "successful pairing commit must carry a revocation token".into(),
+            ));
+        }
+        Ok(Self { session_id: req_id(&v, "session_id")?, status, revocation_token })
+    }
+}
