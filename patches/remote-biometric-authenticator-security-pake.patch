+        private val curve = curveParams.curve
+        private val order = curveParams.n
+        private val generator = curveParams.g
+        private val mPoint = curve.decodePoint(M)
+        private val nPoint = curve.decodePoint(N)
+        private val secureRandom = SecureRandom()
+        private val domainConfirmation = "ConfirmationKeys".toByteArray(Charsets.US_ASCII)
