+        assert!(device.verify_host_confirmation(&finish.host_confirmation).is_err());
+    }
+
+    #[test]
+    fn spake2_authenticates_host_display_name() {
+        let context = test_context();
+        let host = PakeHostSession::with_ephemeral_secret("042069", &[9u8; 32]).unwrap();
+        let host_share = host.share();
+        let (mut device, device_share) =
+            PakeDeviceSession::start_with_ephemeral_secret("042069", &context, &host_share, &[10u8; 32]).unwrap();
+        let finish = host.finish(&context, &device_share).unwrap();
+        let mut substituted = context.clone();
+        substituted.host_name = "spoofed-host".into();
+        let (mut attacker_view, _) =
