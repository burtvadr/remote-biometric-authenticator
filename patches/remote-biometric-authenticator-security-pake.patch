@@ -0,0 +1,543 @@
+//! SPAKE2 pairing key exchange (RFC 9382 construction, P-256 / SHA-256 / HKDF-SHA-256 / HMAC-SHA-256).
+//!
+//! The six-digit pairing code is the PAKE password and is never transmitted.
+//! The host sends its blinded share; the Android responder returns its blinded
+//! share. The host sends cA, which the device verifies before presenting the
+//! explicit owner-approval action. Only after that approval does the device
+//! release cB in PAIRING_COMMIT. The host verifies cB before persisting either
+//! side of the new trust relationship.
+//!
+//! P-256 has cofactor one, so the RFC 9382 cofactor multiplication is the
+//! identity. Received points are validated as canonical uncompressed P-256
+//! points before arithmetic. M and N are the RFC 9382 P-256 points.
+
+use p256::elliptic_curve::ff::Field;
+use p256::elliptic_curve::group::Group;
+use p256::elliptic_curve::sec1::{FromEncodedPoint, ToEncodedPoint};
+use p256::elliptic_curve::PrimeField;
+use p256::{AffinePoint, EncodedPoint, ProjectivePoint, Scalar, SecretKey as P256SecretKey};
+use sha2::{Digest, Sha256};
+use zeroize::Zeroize;
+
+use crate::crypto;
+use crate::errors::{ProtocolError, Result};
+use crate::types::{Id, CHALLENGE_LEN, PAIRING_CODE_DIGITS};
+use crate::crypto::PublicKey;
+
+const M_COMPRESSED: &str = "02886e2f97ace46e55ba9dd7242579f2993b64e16ef3dcab95afd497333d8fa12f";
+const N_COMPRESSED: &str = "03d8bbd6c639c62937b04d997f38c3770719c629d7014d49a24b4f98baa1292b49";
+const DOMAIN_PASSWORD: &[u8] = b"RBA-SPAKE2-PASSWORD-V1\0";
+const DOMAIN_AAD: &[u8] = b"RBA-SPAKE2-AAD-V1\0";
+const DOMAIN_CONFIRMATION: &[u8] = b"ConfirmationKeys";
+const HASH_LEN: usize = 32;
+const CONFIRMATION_KEY_LEN: usize = 16;
+
+/// Context authenticated by the PAKE confirmation key schedule.
+///
+/// Both peers construct this from locally-held identity data and the pairing
+/// messages. Both display names are authenticated: the host name is shown in
+/// the device's approval UI and the device name is stored in the host registry.
+#[derive(Clone)]
+pub struct PairingContext {
+    pub session_id: Id,
+    pub host_id: Id,
+    pub device_id: Id,
+    pub host_pubkey: PublicKey,
+    /// SHA-256 of the actual DER TLS certificate presented on this connection.
+    pub host_tls_cert_hash: [u8; 32],
+    pub host_name: String,
+    pub device_pubkey: PublicKey,
+    pub host_nonce: [u8; CHALLENGE_LEN],
+    pub device_nonce: [u8; CHALLENGE_LEN],
+    pub expires_at: u64,
+    pub device_name: String,
+    /// Pending bearer revocation capabilities are included so a relay cannot
+    /// substitute which earlier pairings are revoked without invalidating the PAKE proof.
+    pub cleanup_tokens: Vec<[u8; 32]>,
+}
+
+impl PairingContext {
+    fn aad(&self) -> Vec<u8> {
+        let mut out = Vec::with_capacity(320 + self.host_name.len() + self.device_name.len());
+        out.extend_from_slice(DOMAIN_AAD);
+        out.push(crate::PROTOCOL_VERSION as u8);
+        out.extend_from_slice(&self.session_id.0);
+        out.extend_from_slice(&self.expires_at.to_be_bytes());
+        out.extend_from_slice(&self.host_nonce);
+        out.extend_from_slice(&self.device_nonce);
+        // This implementation only supports host-generated codes entered on
+        // the device. Keep the direction explicit in the authenticated context.
+        out.push(0);
+        out.extend_from_slice(&self.host_id.0);
+        out.extend_from_slice(self.host_pubkey.as_bytes());
+        out.extend_from_slice(&self.host_tls_cert_hash);
+        append_len_prefixed(&mut out, self.host_name.as_bytes());
+        out.extend_from_slice(&self.device_id.0);
+        out.extend_from_slice(self.device_pubkey.as_bytes());
+        append_len_prefixed(&mut out, self.device_name.as_bytes());
+        out.extend_from_slice(&(self.cleanup_tokens.len() as u32).to_be_bytes());
+        for token in &self.cleanup_tokens {
+            out.extend_from_slice(token);
+        }
+        out
+    }
+}
+
+/// Host-side SPAKE2 initiator. The `code` is secret input and never goes on the
+/// wire; only `share()` is sent in PAIRING_START.
+pub struct PakeHostSession {
+    code: String,
+    w: Scalar,
+    x: P256SecretKey,
+    host_share: [u8; 65],
+}
+
+impl PakeHostSession {
+    pub fn new(code: &str) -> Result<Self> {
+        let x = P256SecretKey::random(&mut p256::elliptic_curve::rand_core::OsRng);
+        Self::with_ephemeral_secret(code, x.to_bytes().as_ref())
+    }
+
+    /// Deterministic constructor used only by the cross-language vector generator.
+    #[doc(hidden)]
+    pub fn with_ephemeral_secret(code: &str, secret: &[u8]) -> Result<Self> {
+        validate_code(code)?;
+        let w = password_scalar(code)?;
+        let x = P256SecretKey::from_slice(secret)
+            .map_err(|_| ProtocolError::BadRequest("invalid SPAKE2 ephemeral scalar".into()))?;
+        let x_scalar = *x.to_nonzero_scalar();
+        let share = ProjectivePoint::GENERATOR * x_scalar + m_point() * w;
+        let host_share = encode_point(&share)?;
+        Ok(Self {
+            code: code.to_owned(),
+            w,
+            x,
+            host_share,
+        })
+    }
+
+    /// Uniform six-digit one-time code, generated with rejection sampling.
+    pub fn random_code() -> Result<String> {
+        const LIMIT: u64 = 4_294_000_000;
+        loop {
+            let bytes = crypto::random_array::<4>()?;
+            let n = u32::from_be_bytes(bytes) as u64;
+            if n < LIMIT {
+                return Ok(format!("{:06}", n % 1_000_000));
+            }
+        }
+    }
+
+    pub fn code(&self) -> &str {
+        &self.code
+    }
+
+    pub fn share(&self) -> [u8; 65] {
+        self.host_share
+    }
+
+    /// Verify the responder's key confirmation and return the initiator's
+    /// confirmation. A wrong code, substituted identity, replay, or altered
+    /// pairing context causes verification to fail before any registry write.
+    pub fn finish(
+        self,
+        context: &PairingContext,
+        device_share: &[u8],
+    ) -> Result<PakeHostFinish> {
+        let peer = decode_point(device_share)?;
+        // A computes K = x * (pB - w*N); h=1 for P-256.
+        let unblinded = ProjectivePoint::from(peer) - n_point() * self.w;
+        if bool::from(unblinded.is_identity()) {
+            return Err(ProtocolError::BadRequest(
+                "SPAKE2 peer share unblinds to the identity".into(),
+            ));
+        }
+        let shared = unblinded * *self.x.to_nonzero_scalar();
+        let keys = derive_confirmation_keys(
+            context,
+            &self.host_share,
+            device_share,
+            &shared,
+            &self.w,
+        )?;
+        Ok(PakeHostFinish {
+            host_confirmation: crypto::hmac_sha256(&keys.host_key, &keys.transcript),
+            expected_device_confirmation: crypto::hmac_sha256(&keys.device_key, &keys.transcript),
+        })
+    }
+}
+
+/// Host-side state retained until the device owner explicitly approves pairing.
+pub struct PakeHostFinish {
+    pub host_confirmation: [u8; 32],
+    expected_device_confirmation: [u8; 32],
+}
+
+impl PakeHostFinish {
+    /// Verify B's RFC 9382 key confirmation. RBA sends it only after the phone
+    /// has verified A's confirmation and the owner has tapped Allow.
+    pub fn verify_device_commit(&self, received: &[u8]) -> Result<()> {
+        if !crypto::ct_eq_slice(received, &self.expected_device_confirmation) {
+            return Err(ProtocolError::SignatureInvalid);
+        }
+        Ok(())
+    }
+}
+
+impl Drop for PakeHostFinish {
+    fn drop(&mut self) {
+        self.host_confirmation.zeroize();
+        self.expected_device_confirmation.zeroize();
+    }
+}
+
+impl Drop for PakeHostSession {
+    fn drop(&mut self) {
+        self.code.zeroize();
+        self.w.zeroize();
+        self.host_share.zeroize();
+        // P256SecretKey is zeroized by its own Drop implementation.
+    }
+}
+
+/// Device-side SPAKE2 responder. The phone constructs this only after the user
+/// enters the host's displayed code. Its share is sent in PAIRING_SUBMIT; its
+/// cB confirmation is withheld until cA has been verified and the owner approves.
+pub struct PakeDeviceSession {
+    expected_host_confirmation: [u8; 32],
+    device_confirmation: [u8; 32],
+    host_verified: bool,
+}
+
+impl PakeDeviceSession {
+    pub fn start(
+        code: &str,
+        context: &PairingContext,
+        host_share: &[u8],
+    ) -> Result<(Self, [u8; 65])> {
+        let y = P256SecretKey::random(&mut p256::elliptic_curve::rand_core::OsRng);
+        Self::start_with_ephemeral_secret(code, context, host_share, y.to_bytes().as_ref())
+    }
+
+    /// Deterministic responder constructor used only by conformance vectors.
+    #[doc(hidden)]
+    pub fn start_with_ephemeral_secret(
+        code: &str,
+        context: &PairingContext,
+        host_share: &[u8],
+        secret: &[u8],
+    ) -> Result<(Self, [u8; 65])> {
+        validate_code(code)?;
+        let w = password_scalar(code)?;
+        let peer = decode_point(host_share)?;
+        let y = P256SecretKey::from_slice(secret)
+            .map_err(|_| ProtocolError::BadRequest("invalid SPAKE2 ephemeral scalar".into()))?;
+        let y_scalar = *y.to_nonzero_scalar();
+        // B computes pB = y*P + w*N, then K = y*(pA - w*M).
+        let device_share_point = ProjectivePoint::GENERATOR * y_scalar + n_point() * w;
+        let device_share = encode_point(&device_share_point)?;
+        let unblinded = ProjectivePoint::from(peer) - m_point() * w;
+        if bool::from(unblinded.is_identity()) {
+            return Err(ProtocolError::BadRequest(
+                "SPAKE2 peer share unblinds to the identity".into(),
+            ));
+        }
+        let shared = unblinded * y_scalar;
+        let keys = derive_confirmation_keys(
+            context,
+            host_share,
+            &device_share,
+            &shared,
+            &w,
+        )?;
+        let session = Self {
+            expected_host_confirmation: crypto::hmac_sha256(
+                &keys.host_key,
+                &keys.transcript,
+            ),
+            device_confirmation: crypto::hmac_sha256(
+                &keys.device_key,
+                &keys.transcript,
+            ),
+            host_verified: false,
+        };
+        Ok((session, device_share))
+    }
+
+    pub fn verify_host_confirmation(&mut self, received: &[u8]) -> Result<()> {
+        if !crypto::ct_eq_slice(received, &self.expected_host_confirmation) {
+            self.host_verified = false;
+            self.expected_host_confirmation.zeroize();
+            self.device_confirmation.zeroize();
+            return Err(ProtocolError::SignatureInvalid);
+        }
+        self.expected_host_confirmation.zeroize();
+        self.host_verified = true;
+        Ok(())
+    }
+
+    /// Release B's RFC 9382 key confirmation only after A's confirmation was
+    /// verified and the device owner explicitly approved the pairing.
+    pub fn commit_proof(&self) -> Result<[u8; 32]> {
+        if !self.host_verified {
+            return Err(ProtocolError::SignatureInvalid);
+        }
+        Ok(self.device_confirmation)
+    }
+}
+
+impl Drop for PakeDeviceSession {
+    fn drop(&mut self) {
+        self.expected_host_confirmation.zeroize();
+        self.device_confirmation.zeroize();
+    }
+}
+
+struct ConfirmationKeys {
+    host_key: [u8; CONFIRMATION_KEY_LEN],
+    device_key: [u8; CONFIRMATION_KEY_LEN],
+    transcript: Vec<u8>,
+}
+
+impl Drop for ConfirmationKeys {
+    fn drop(&mut self) {
+        self.host_key.zeroize();
+        self.device_key.zeroize();
+        self.transcript.zeroize();
+    }
+}
+
+fn derive_confirmation_keys(
+    context: &PairingContext,
+    host_share: &[u8],
+    device_share: &[u8],
+    shared: &ProjectivePoint,
+    w: &Scalar,
+) -> Result<ConfirmationKeys> {
+    if host_share.len() != 65 || device_share.len() != 65 {
+        return Err(ProtocolError::BadRequest(
+            "SPAKE2 shares must be 65-byte uncompressed P-256 points".into(),
+        ));
+    }
+    if bool::from(shared.is_identity()) {
+        return Err(ProtocolError::BadRequest(
+            "SPAKE2 shared point is the identity".into(),
+        ));
+    }
+    let a = identity_bytes(&context.host_id, &context.host_pubkey);
+    let b = identity_bytes(&context.device_id, &context.device_pubkey);
+    let k = encode_point(shared)?;
+    let mut w_bytes = w.to_bytes();
+
+    // RFC 9382 §3.3: len fields are eight-byte little-endian integers.
+    let mut transcript = Vec::with_capacity(512);
+    append_len_prefixed(&mut transcript, &a);
+    append_len_prefixed(&mut transcript, &b);
+    append_len_prefixed(&mut transcript, host_share);
+    append_len_prefixed(&mut transcript, device_share);
+    append_len_prefixed(&mut transcript, &k);
+    append_len_prefixed(&mut transcript, w_bytes.as_slice());
+
+    // RFC 9382 §4: Hash(TT) = Ke || Ka. Ke is not needed by this pairing
+    // protocol; Ka is used exclusively to derive directional confirmation keys.
+    let mut digest = crypto::sha256(&transcript);
+    let mut ka = [0u8; 16];
+    ka.copy_from_slice(&digest[16..32]);
+    let mut info = Vec::with_capacity(DOMAIN_CONFIRMATION.len() + 256);
+    info.extend_from_slice(DOMAIN_CONFIRMATION);
+    info.extend_from_slice(&context.aad());
+    let mut confirmation = [0u8; 32];
+    // RFC 5869's nil salt means HashLen zero octets, not a zero-length HMAC key.
+    let zero_salt = [0u8; HASH_LEN];
+    crypto::hkdf_sha256(&ka, &zero_salt, &info, &mut confirmation)?;
+    let mut host_key = [0u8; CONFIRMATION_KEY_LEN];
+    let mut device_key = [0u8; CONFIRMATION_KEY_LEN];
+    host_key.copy_from_slice(&confirmation[..CONFIRMATION_KEY_LEN]);
+    device_key.copy_from_slice(&confirmation[CONFIRMATION_KEY_LEN..]);
+
+    digest.zeroize();
+    ka.zeroize();
+    w_bytes.zeroize();
+    confirmation.zeroize();
+    info.zeroize();
+    Ok(ConfirmationKeys {
+        host_key,
+        device_key,
+        transcript,
+    })
+}
+
+fn identity_bytes(id: &Id, public_key: &PublicKey) -> Vec<u8> {
+    let mut out = Vec::with_capacity(16 + 65);
+    out.extend_from_slice(&id.0);
+    out.extend_from_slice(public_key.as_bytes());
+    out
+}
+
+fn append_len_prefixed(out: &mut Vec<u8>, bytes: &[u8]) {
+    out.extend_from_slice(&(bytes.len() as u64).to_le_bytes());
+    out.extend_from_slice(bytes);
+}
+
+fn validate_code(code: &str) -> Result<()> {
+    if code.len() != PAIRING_CODE_DIGITS || !code.bytes().all(|b| b.is_ascii_digit()) {
+        return Err(ProtocolError::BadRequest(
+            "pairing code must be exactly six ASCII digits".into(),
+        ));
+    }
+    Ok(())
+}
+
+/// Hash the six ASCII digits to a non-zero scalar by rejection sampling. The
+/// small password space is protected by SPAKE2: a passive network observer
+/// cannot test guesses offline, and each active exchange permits one online
+/// guess. The host also rate-limits creation of pairing sessions.
+fn password_scalar(code: &str) -> Result<Scalar> {
+    for counter in 0u32..u32::MAX {
+        let mut input = Vec::with_capacity(DOMAIN_PASSWORD.len() + code.len() + 4);
+        input.extend_from_slice(DOMAIN_PASSWORD);
+        input.extend_from_slice(code.as_bytes());
+        input.extend_from_slice(&counter.to_be_bytes());
+        let digest = crypto::sha256(&input);
+        let repr: p256::FieldBytes = digest.into();
+        if let Some(scalar) = Option::<Scalar>::from(Scalar::from_repr(repr)) {
+            if scalar != Scalar::ZERO {
+                input.zeroize();
+                return Ok(scalar);
+            }
+        }
+        input.zeroize();
+    }
+    Err(ProtocolError::Internal(
+        "could not map the pairing code to a P-256 scalar".into(),
+    ))
+}
+
+fn decode_point(bytes: &[u8]) -> Result<AffinePoint> {
+    if bytes.len() != 65 || bytes.first() != Some(&0x04) {
+        return Err(ProtocolError::BadRequest(
+            "SPAKE2 share must be a 65-byte uncompressed P-256 point".into(),
+        ));
+    }
+    let encoded = EncodedPoint::from_bytes(bytes)
+        .map_err(|_| ProtocolError::BadRequest("malformed SPAKE2 point".into()))?;
+    Option::<AffinePoint>::from(AffinePoint::from_encoded_point(&encoded))
+        .ok_or_else(|| ProtocolError::BadRequest("SPAKE2 point is not on P-256".into()))
+}
+
+fn encode_point(point: &ProjectivePoint) -> Result<[u8; 65]> {
+    if bool::from(point.is_identity()) {
+        return Err(ProtocolError::BadRequest(
+            "SPAKE2 produced the identity point".into(),
+        ));
+    }
+    let encoded = point.to_affine().to_encoded_point(false);
+    let mut out = [0u8; 65];
+    out.copy_from_slice(encoded.as_bytes());
+    Ok(out)
+}
+
+fn m_point() -> ProjectivePoint {
+    static POINT: std::sync::OnceLock<ProjectivePoint> = std::sync::OnceLock::new();
+    *POINT.get_or_init(|| {
+        let bytes = hex::decode(M_COMPRESSED).expect("RFC 9382 M point hex");
+        let encoded = EncodedPoint::from_bytes(bytes).expect("RFC 9382 M point encoding");
+        let affine = Option::<AffinePoint>::from(AffinePoint::from_encoded_point(&encoded))
+            .expect("RFC 9382 M point is on P-256");
+        ProjectivePoint::from(affine)
+    })
+}
+
+fn n_point() -> ProjectivePoint {
+    static POINT: std::sync::OnceLock<ProjectivePoint> = std::sync::OnceLock::new();
+    *POINT.get_or_init(|| {
+        let bytes = hex::decode(N_COMPRESSED).expect("RFC 9382 N point hex");
+        let encoded = EncodedPoint::from_bytes(bytes).expect("RFC 9382 N point encoding");
+        let affine = Option::<AffinePoint>::from(AffinePoint::from_encoded_point(&encoded))
+            .expect("RFC 9382 N point is on P-256");
+        ProjectivePoint::from(affine)
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use p256::elliptic_curve::sec1::ToEncodedPoint;
+
+    fn test_context() -> PairingContext {
+        let host = crate::crypto::PrivateKey::from_bytes(&[7u8; 32]).unwrap();
+        let device = crate::crypto::PrivateKey::from_bytes(&[8u8; 32]).unwrap();
+        PairingContext {
+            session_id: Id([1u8; 16]),
+            host_id: Id([2u8; 16]),
+            device_id: Id([3u8; 16]),
+            host_pubkey: host.public_key(),
+            host_tls_cert_hash: [6u8; 32],
+            host_name: "test-host".into(),
+            device_pubkey: device.public_key(),
+            host_nonce: [4u8; 32],
+            device_nonce: [5u8; 32],
+            expires_at: 1_900_000_000,
+            device_name: "test-device".into(),
+            cleanup_tokens: Vec::new(),
+        }
+    }
+
+    #[test]
+    fn spake2_both_sides_confirm_and_wrong_password_fails() {
+        let context = test_context();
+        let host = PakeHostSession::new("042069").unwrap();
+        let host_share = host.share();
+        let (mut device, device_share) =
+            PakeDeviceSession::start("042069", &context, &host_share).unwrap();
+        let finish = host.finish(&context, &device_share).unwrap();
+        device.verify_host_confirmation(&finish.host_confirmation).unwrap();
+        let commit = device.commit_proof().unwrap();
+        finish.verify_device_commit(&commit).unwrap();
+
