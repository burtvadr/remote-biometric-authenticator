+/** Inputs authenticated by SPAKE2 confirmation keys. */
+data class PairingContext(
+    val sessionId: Id,
+    val hostId: Id,
+    val deviceId: Id,
+    val hostPublicKey: ByteArray,
+    val hostTlsCertHash: ByteArray,
+    val hostName: String,
+    val devicePublicKey: ByteArray,
+    val hostNonce: ByteArray,
+    val deviceNonce: ByteArray,
+    val expiresAt: Long,
+    val deviceName: String,
+    val cleanupTokens: List<ByteArray> = emptyList(),
+) {
+    init {
+        require(hostPublicKey.size == Limits.PUBKEY_LEN)
+        require(hostTlsCertHash.size == 32)
+        require(hostName.isNotEmpty() && hostName.codePointCount(0, hostName.length) <= Limits.MAX_NAME_LEN && '\u0000' !in hostName)
+        require(devicePublicKey.size == Limits.PUBKEY_LEN)
+        require(hostNonce.size == Limits.CHALLENGE_LEN)
+        require(deviceNonce.size == Limits.CHALLENGE_LEN)
+        require(cleanupTokens.size <= MAX_CLEANUP_TOKENS)
+        require(cleanupTokens.all { it.size == 32 })
+        require(deviceName.isNotEmpty() && deviceName.codePointCount(0, deviceName.length) <= Limits.MAX_NAME_LEN && '\u0000' !in deviceName)
+    }
+
+    /** Must stay byte-for-byte aligned with `PairingContext::aad` in Rust. */
+    internal fun aad(): ByteArray {
+        val out = ByteArrayOutputStream()
+        out.write(PAKE_AAD_DOMAIN)
+        out.write(Limits.PROTOCOL_VERSION)
+        out.write(sessionId.bytes)
+        out.write(ByteBuffer.allocate(8).order(ByteOrder.BIG_ENDIAN).putLong(expiresAt).array())
+        out.write(hostNonce)
+        out.write(deviceNonce)
+        out.write(0) // code_entry = device
+        out.write(hostId.bytes)
+        out.write(hostPublicKey)
+        out.write(hostTlsCertHash)
+        out.writeLengthPrefixed(hostName.toByteArray(Charsets.UTF_8))
+        out.write(deviceId.bytes)
+        out.write(devicePublicKey)
+        out.writeLengthPrefixed(deviceName.toByteArray(Charsets.UTF_8))
+        out.write(ByteBuffer.allocate(4).order(ByteOrder.BIG_ENDIAN).putInt(cleanupTokens.size).array())
+        cleanupTokens.forEach { out.write(it) }
+        return out.toByteArray()
