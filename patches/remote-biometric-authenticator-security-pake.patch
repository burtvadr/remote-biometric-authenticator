+data class PairingCommit(
+    val sessionId: Id,
+    /** B's RFC 9382 key confirmation, released only after explicit owner approval. */
+    val deviceConfirmation: ByteArray,
+) {
+    fun toPayload(): ByteArray = Cbor.encode(
+        Cbor.ofMap(
+            "device_confirmation" to Cbor.bytes(deviceConfirmation),
+            "session_id" to Cbor.bytes(sessionId.bytes),
+        ),
+    )
+
+    companion object {
+        fun fromPayload(payload: ByteArray): PairingCommit {
+            val v = Cbor.decode(payload) as? Cbor.Value.Map
+                ?: throw ProtocolException(ErrorCode.BAD_REQUEST, "pairing_commit is not a map")
+            val confirmation = (v["device_confirmation"] as? Cbor.Value.Bytes)?.value
+                ?: throw ProtocolException(ErrorCode.BAD_REQUEST, "missing pairing_commit device_confirmation")
+            if (confirmation.size != 32) throw ProtocolException(ErrorCode.BAD_REQUEST, "pairing_commit device_confirmation must be 32 bytes")
+            val session = (v["session_id"] as? Cbor.Value.Bytes)?.value
+                ?: throw ProtocolException(ErrorCode.BAD_REQUEST, "missing pairing_commit session_id")
+            return PairingCommit(Id(session), confirmation)
+        }
+    }
+}
+
+data class PairingCommitResult(
+    val sessionId: Id,
+    val status: Long,
+    val revocationToken: ByteArray?,
+) {
+    fun toPayload(): ByteArray {
+        val entries = mutableListOf(
+            "session_id" to Cbor.bytes(sessionId.bytes),
+            "status" to Cbor.uint(status),
+        )
+        revocationToken?.let { entries += "revocation_token" to Cbor.bytes(it) }
+        return Cbor.encode(Cbor.ofMap(*entries.toTypedArray()))
+    }
+
+    companion object {
+        fun fromPayload(payload: ByteArray): PairingCommitResult {
+            val v = Cbor.decode(payload) as? Cbor.Value.Map
+                ?: throw ProtocolException(ErrorCode.BAD_REQUEST, "pairing_commit_result is not a map")
+            val status = (v["status"] as? Cbor.Value.Uint)?.value
+                ?: throw ProtocolException(ErrorCode.BAD_REQUEST, "missing pairing_commit_result status")
+            if (status !in 0L..1L) throw ProtocolException(ErrorCode.BAD_REQUEST, "invalid pairing_commit_result status")
+            val token = (v["revocation_token"] as? Cbor.Value.Bytes)?.value
+            if (token != null && token.size != 32) {
+                throw ProtocolException(ErrorCode.BAD_REQUEST, "revocation_token must be 32 bytes")
+            }
+            if (status == 0L && token == null) {
+                throw ProtocolException(ErrorCode.BAD_REQUEST, "successful pairing commit must carry revocation_token")
+            }
+            val session = (v["session_id"] as? Cbor.Value.Bytes)?.value
+                ?: throw ProtocolException(ErrorCode.BAD_REQUEST, "missing pairing_commit_result session_id")
+            return PairingCommitResult(Id(session), status, token)
+        }
+    }
+}
