+/** Device-side SPAKE2 responder using the RFC 9382 P-256 construction. */
+class Spake2DeviceSession private constructor(
+    private val expectedHostConfirmation: ByteArray,
+    private val deviceConfirmation: ByteArray,
+) {
+    private var hostVerified = false
+
+    /** Verify the host's reciprocal key-confirmation MAC before allowing commit. */
+    fun verifyHostConfirmation(received: ByteArray) {
+        if (!constantTimeEquals(received, expectedHostConfirmation)) {
+            hostVerified = false
+            expectedHostConfirmation.fill(0)
+            deviceConfirmation.fill(0)
+            throw ProtocolException(ErrorCode.SIGNATURE_INVALID, "SPAKE2 host confirmation failed")
+        }
+        hostVerified = true
+        expectedHostConfirmation.fill(0)
+    }
+
+    /** Release B's RFC 9382 confirmation only after host proof and owner approval. */
+    fun commitProof(): ByteArray {
+        if (!hostVerified) {
+            throw ProtocolException(ErrorCode.SIGNATURE_INVALID, "host confirmation has not been verified")
+        }
+        return deviceConfirmation.copyOf()
+    }
+
+    fun wipe() {
+        expectedHostConfirmation.fill(0)
+        deviceConfirmation.fill(0)
+        hostVerified = false
+    }
