+/// SHA-256 fingerprint of the first DER certificate in the host's PEM chain.
+/// This exact value is advertised in PAIRING_START and then checked against the
+/// certificate the device actually observed during the initial TLS handshake.
+pub fn certificate_fingerprint(cert_pem: &[u8]) -> Result<[u8; 32]> {
+    let mut cursor = std::io::Cursor::new(cert_pem);
+    let certs: Vec<rustls::pki_types::CertificateDer<'static>> = rustls_pemfile::certs(&mut cursor)
+        .collect::<std::result::Result<Vec<_>, _>>()
+        .map_err(|e| ProtocolError::Internal(format!("parse host certificate: {e}")))?;
+    let cert = certs.first().ok_or_else(|| ProtocolError::Internal("host certificate file contains no certificates".into()))?;
+    Ok(rba_protocol::crypto::sha256(cert.as_ref()))
+}
+
+/// Ensure the certificate exists and return the fingerprint used by PAKE.
+pub fn host_certificate_fingerprint(config: &Config) -> Result<[u8; 32]> {
+    let (cert_pem, mut private_key) = load_or_create_host_tls_material(config)?;
+    use zeroize::Zeroize;
+    private_key.zeroize();
+    certificate_fingerprint(&cert_pem)
+}
