+            val tt = transcript.toByteArray()
+            val digest = sha256(tt)
+            // RFC 9382 §4: Hash(TT) = Ke || Ka; Ka is the rightmost 16 octets.
+            val ka = digest.copyOfRange(16, 32)
+            val info = domainConfirmation + context.aad()
+            val confirmation = hkdf(ka, ByteArray(32), info, 32)
+            val hostKey = confirmation.copyOfRange(0, 16)
+            val deviceKey = confirmation.copyOfRange(16, 32)
+            digest.fill(0)
+            ka.fill(0)
+            passwordBytes.fill(0)
+            confirmation.fill(0)
+            return ConfirmationKeys(hostKey, deviceKey, tt)
+        }
+
+        private fun fixed32(value: BigInteger): ByteArray {
+            val raw = value.toByteArray().let {
+                if (it.size == 33 && it[0] == 0.toByte()) it.copyOfRange(1, 33) else it
+            }
+            require(raw.size <= 32) { "scalar does not fit in 32 bytes" }
+            return ByteArray(32 - raw.size) + raw
+        }
+
+        private data class ConfirmationKeys(
+            val hostKey: ByteArray,
+            val deviceKey: ByteArray,
+            val transcript: ByteArray,
+        ) {
+            fun wipe() {
+                hostKey.fill(0)
+                deviceKey.fill(0)
+                transcript.fill(0)
+            }
+        }
+    }
+}
