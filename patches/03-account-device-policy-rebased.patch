@@ -0,0 +1,276 @@
+//! Versioned, persistent host-side authorization matrix.
+//!
+//! The effective permission is the intersection of: a paired device, its
+//! operator-owned device policy, the target account's allow-list and policy,
+//! and the live session's capabilities. Delegation is an explicit, root-managed
+//! exception to *ownership*, never to operation or elevation checks.
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::{Path, PathBuf};
+
+use rba_protocol::capabilities::KNOWN_OPERATIONS;
+use rba_protocol::cbor::Value;
+use rba_protocol::errors::{ProtocolError, Result};
+use rba_protocol::types::Id;
+
+use crate::config;
+use crate::registry::DeviceRecord;
+
+const DEFAULT_RATE: u32 = 5;
+const MAX_RATE: u32 = 60;
+
+pub fn valid_user(user: &str) -> bool {
+    !user.is_empty() && user.len() <= 64 && user != "." && user != ".."
+        && user.bytes().all(|b| b.is_ascii_alphanumeric() || b"_.-".contains(&b))
+}
+
+pub fn valid_operations(ops: &[String]) -> bool {
+    ops.len() <= KNOWN_OPERATIONS.len()
+        && ops.iter().all(|op| KNOWN_OPERATIONS.contains(&op.as_str()))
+        && ops.iter().collect::<BTreeSet<_>>().len() == ops.len()
+}
+
+fn valid_devices(devices: &[String]) -> bool {
+    devices.len() <= 128 && devices.iter().all(|id| Id::from_hex(id).is_ok())
+        && devices.iter().collect::<BTreeSet<_>>().len() == devices.len()
+}
+
+#[derive(Debug, Clone, Default)]
+pub struct PolicyPatch {
+    pub device_login: Option<bool>,
+    pub allowed_devices: Option<Vec<String>>,
+    pub delegated_devices: Option<Vec<String>>,
+    pub allowed_operations: Option<Vec<String>>,
+    pub allow_elevated: Option<bool>,
+    pub rate_per_minute: Option<u32>,
+}
+
+impl PolicyPatch {
+    /// All fields except self-service device_login require root.
+    pub fn administrative(&self) -> bool {
+        self.allowed_devices.is_some() || self.delegated_devices.is_some()
+            || self.allowed_operations.is_some() || self.allow_elevated.is_some()
+            || self.rate_per_minute.is_some()
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AccountPolicy {
+    pub user: String,
+    pub device_login: bool,
+    pub allowed_devices: Vec<String>,
+    pub delegated_devices: Vec<String>,
+    pub allowed_operations: Vec<String>,
+    pub allow_elevated: bool,
+    pub rate_per_minute: u32,
+}
+
+impl AccountPolicy {
+    pub fn deny_all(user: &str) -> Self {
+        Self { user: user.into(), device_login: false, allowed_devices: vec![],
+            delegated_devices: vec![], allowed_operations: vec!["authenticate".into(), "login".into(), "unlock".into()],
+            allow_elevated: false, rate_per_minute: DEFAULT_RATE }
+    }
+    fn update(&mut self, patch: &PolicyPatch) -> Result<()> {
+        if let Some(v) = patch.device_login { self.device_login = v; }
+        if let Some(v) = &patch.allowed_devices { self.allowed_devices = v.clone(); }
+        if let Some(v) = &patch.delegated_devices { self.delegated_devices = v.clone(); }
+        if let Some(v) = &patch.allowed_operations { self.allowed_operations = v.clone(); }
+        if let Some(v) = patch.allow_elevated { self.allow_elevated = v; }
+        if let Some(v) = patch.rate_per_minute { self.rate_per_minute = v; }
+        self.validate()
+    }
+    fn validate(&self) -> Result<()> {
+        if !valid_user(&self.user) || !valid_devices(&self.allowed_devices)
+            || !valid_devices(&self.delegated_devices)
+            || self.allowed_operations.is_empty() || !valid_operations(&self.allowed_operations)
+            || self.rate_per_minute == 0 || self.rate_per_minute > MAX_RATE {
+            return Err(ProtocolError::BadRequest("invalid account policy field".into()));
+        }
+        if !self.delegated_devices.iter().all(|id| self.allowed_devices.contains(id)) {
+            return Err(ProtocolError::BadRequest("delegated device must also be allowed".into()));
+        }
+        Ok(())
+    }
+    pub fn to_value(&self) -> Value {
+        Value::map([
+            ("v", Value::Uint(1)), ("user", Value::Text(self.user.clone())),
+            ("device_login", Value::Bool(self.device_login)),
+            ("allowed_devices", texts(&self.allowed_devices)),
+            ("delegated_devices", texts(&self.delegated_devices)),
+            ("allowed_operations", texts(&self.allowed_operations)),
+            ("allow_elevated", Value::Bool(self.allow_elevated)),
+            ("rate_per_minute", Value::Uint(self.rate_per_minute as u64)),
+        ])
+    }
+    fn from_value(v: &Value) -> Option<Self> {
+        let Value::Map(entries) = v else { return None; };
+        if entries.len() != 8 || v.get("v")?.as_uint()? != 1 { return None; }
+        let policy = Self {
+            user: v.get("user")?.as_text()?.into(),
+            device_login: v.get("device_login")?.as_bool()?,
+            allowed_devices: read_texts(v.get("allowed_devices")?)?,
+            delegated_devices: read_texts(v.get("delegated_devices")?)?,
+            allowed_operations: read_texts(v.get("allowed_operations")?)?,
+            allow_elevated: v.get("allow_elevated")?.as_bool()?,
+            rate_per_minute: v.get("rate_per_minute")?.as_uint()?.try_into().ok()?,
+        };
+        policy.validate().ok()?;
+        Some(policy)
+    }
+    pub fn authorize(&self, device: &DeviceRecord, op: &str) -> Result<()> {
+        let id = &device.device_id;
+        if !self.device_login || !device.policy.device_login
+            || !device.status.may_authenticate()
+            || !self.allowed_devices.contains(id)
+            || !self.allowed_operations.iter().any(|o| o == op)
+            || !device.policy.allowed_operations.iter().any(|o| o == op) {
+            return Err(ProtocolError::ContextMismatch("account/device policy denies operation".into()));
+        }
+        let owner = device.policy.users.first().map(String::as_str) == Some(self.user.as_str());
+        if !owner {
+            if self.user == "root" || !device.policy.allow_delegation
+                || !self.delegated_devices.contains(id) {
+                return Err(ProtocolError::ContextMismatch("device has no delegation for account".into()));
+            }
+        }
+        let elevated = matches!(op, "sudo" | "polkit") || self.user == "root";
+        if elevated && (!owner || !self.allow_elevated || !device.policy.allow_elevated) {
+            return Err(ProtocolError::ContextMismatch("elevated authentication not permitted".into()));
+        }
+        if self.user == "root" && !device.policy.allow_root {
+            return Err(ProtocolError::ContextMismatch("root requires explicit device opt-in".into()));
+        }
+        Ok(())
+    }
+}
+
+fn texts(s: &[String]) -> Value { Value::Array(s.iter().cloned().map(Value::Text).collect()) }
+fn read_texts(v: &Value) -> Option<Vec<String>> {
+    let Value::Array(items) = v else { return None; };
+    items.iter().map(|x| x.as_text().map(str::to_owned)).collect()
+}
+
+pub struct AccountPolicies {
+    path: Option<PathBuf>,
+    accounts: BTreeMap<String, AccountPolicy>,
+}
+impl AccountPolicies {
+    pub fn in_memory() -> Self { Self { path: None, accounts: BTreeMap::new() } }
+    pub fn load(path: &Path) -> Result<Self> {
+        let mut out = Self { path: Some(path.to_owned()), accounts: BTreeMap::new() };
+        if !path.exists() { return Ok(out); }
+        for item in std::fs::read_dir(path).map_err(|e| ProtocolError::Internal(format!("read accounts: {e}")))? {
+            let item = item.map_err(|e| ProtocolError::Internal(format!("read account record: {e}")))?;
+            if !item.file_type().map(|t| t.is_file()).unwrap_or(false) { continue; }
+            let user = item.file_name().to_string_lossy().to_string();
+            if !valid_user(&user) { continue; }
+            let raw = std::fs::read_to_string(item.path())
+                .map_err(|e| ProtocolError::Internal(format!("read account {user}: {e}")))?;
+            let policy = rba_protocol::line::decode_cbor_line(&raw)
+                .and_then(|v| AccountPolicy::from_value(&v))
+                .ok_or_else(|| ProtocolError::Internal(format!("invalid policy for {user}; failing closed")))?;
+            if policy.user != user { return Err(ProtocolError::Internal("account policy filename mismatch".into())); }
+            out.accounts.insert(user, policy);
+        }
+        Ok(out)
+    }
+    pub fn get(&self, user: &str) -> AccountPolicy {
+        self.accounts.get(user).cloned().unwrap_or_else(|| AccountPolicy::deny_all(user))
+    }
+    fn write(&self, policy: &AccountPolicy) -> Result<()> {
+        if let Some(dir) = &self.path {
+            config::write_private(&dir.join(&policy.user), rba_protocol::line::encode_cbor_line(&policy.to_value()).as_bytes())
+                .map_err(|e| ProtocolError::Internal(format!("save account policy: {e}")))?;
+        }
+        Ok(())
+    }
+    /// Physical pairing enrolls exactly the owner and its verified device ID.
+    /// This never adds a delegated account or enables elevation.
+    pub fn enrol(&mut self, user: &str, device: &Id) -> Result<()> {
+        if !valid_user(user) { return Err(ProtocolError::BadRequest("invalid account name".into())); }
+        let mut policy = self.get(user);
+        let id = device.to_hex();
+        if !policy.allowed_devices.contains(&id) { policy.allowed_devices.push(id); }
+        policy.device_login = true;
+        policy.validate()?;
+        self.write(&policy)?;
+        self.accounts.insert(user.into(), policy);
+        Ok(())
+    }
+    /// Root may configure the matrix; ordinary users can only toggle their own
+    /// device_login flag (not add devices or raise privilege/rate caps).
+    pub fn patch(&mut self, user: &str, patch: &PolicyPatch, admin: bool) -> Result<AccountPolicy> {
+        if !valid_user(user) { return Err(ProtocolError::BadRequest("invalid account name".into())); }
+        if !admin && patch.administrative() {
+            return Err(ProtocolError::ContextMismatch("policy management requires root".into()));
+        }
+        let mut policy = self.get(user);
+        policy.update(patch)?;
+        self.write(&policy)?;
+        self.accounts.insert(user.into(), policy.clone());
+        Ok(policy)
+    }
+}
+
+#[cfg(test)] mod tests {
+    use super::*;
+    use crate::registry::{DevicePolicy, DeviceStatus};
+    fn fixture() -> (AccountPolicy, DeviceRecord) {
+        let device = Id::from_slice(&[7u8; 16]).unwrap();
+        let mut acc = AccountPolicy::deny_all("alice");
+        acc.device_login = true;
+        acc.allowed_devices.push(device.to_hex());
+        let rec = DeviceRecord { device_id: device.to_hex(), name: "key".into(), public_key: String::new(),
+            added_at: 1, last_seen: None, status: DeviceStatus::Paired,
+            policy: DevicePolicy::for_user("alice"), revocation_token_hash: None, auth_count: 0 };
+        (acc, rec)
+    }
+    #[test] fn intersection_deny_login_elevation_and_unlisted() {
+        let (mut a, mut d) = fixture();
+        assert!(a.authorize(&d, "login").is_ok());
+        a.device_login = false;
+        assert!(a.authorize(&d, "login").is_err());
+        a.device_login = true;
+        assert!(a.authorize(&d, "sudo").is_err());
+        a.allowed_operations.push("sudo".into());
+        a.allow_elevated = true;
+        assert!(a.authorize(&d, "sudo").is_err());
+        d.policy.allowed_operations.push("sudo".into());
+        d.policy.allow_elevated = true;
+        assert!(a.authorize(&d, "sudo").is_ok());
+        a.allowed_devices.clear();
+        assert!(a.authorize(&d, "login").is_err());
+        d.status = DeviceStatus::Revoked;
+        assert!(a.authorize(&d, "login").is_err());
+    }
+    #[test] fn delegation_is_explicit_and_never_elevates() {
+        let (mut a, mut d) = fixture();
+        a.user = "bob".into();
+        assert!(a.authorize(&d, "login").is_err());
+        a.delegated_devices.push(d.device_id.clone());
+        assert!(a.authorize(&d, "login").is_err());
+        d.policy.allow_delegation = true;
+        assert!(a.authorize(&d, "login").is_ok());
+        a.allowed_operations.push("sudo".into());
+        a.allow_elevated = true;
+        d.policy.allowed_operations.push("sudo".into());
+        d.policy.allow_elevated = true;
+        assert!(a.authorize(&d, "sudo").is_err());
+    }
+    #[test] fn persistence_is_canonical_and_malformed_fails() {
+        let dir = std::env::temp_dir().join(format!("rba-account-test-{}",std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        let id = Id::from_slice(&[1u8;16]).unwrap();
+        let mut set = AccountPolicies::load(&dir).unwrap();
+        set.enrol("alice", &id).unwrap();
+        assert!(AccountPolicies::load(&dir).unwrap().get("alice").allowed_devices.contains(&id.to_hex()));
+        std::fs::write(dir.join("alice"), "{}\\n").unwrap();
+        assert!(AccountPolicies::load(&dir).is_err());
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+    #[test] fn ordinary_user_cannot_change_admin_fields() {
+        let mut set = AccountPolicies::in_memory();
+        assert!(set.patch("alice", &PolicyPatch { allow_elevated: Some(true), ..Default::default() },false).is_err());
+        assert!(set.patch("alice", &PolicyPatch { device_login: Some(false), ..Default::default() },false).is_ok());
+    }
+}
