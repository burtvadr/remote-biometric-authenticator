+    /** Effective device-side capability toggles for one pinned host.
+     * Unknown operations are never enabled. Changes take effect immediately
+     * when requests arrive; newly enabled operations require a new session.
+     */
+    fun allowedOperations(context: Context, hostId: String): Set<String> =
+        prefs(context).getStringSet(KEY_HOST_OPERATIONS + hostId, null)
+            ?.intersect(KNOWN_OPERATIONS) ?: KNOWN_OPERATIONS
+
+    fun setAllowedOperation(context: Context, hostId: String, operation: String, allowed: Boolean) {
+        require(operation in KNOWN_OPERATIONS)
+        require(hostId.length == 32 && hostId.all { it in "0123456789abcdef" })
+        val changed = allowedOperations(context, hostId).toMutableSet()
+        if (allowed) changed.add(operation) else changed.remove(operation)
+        prefs(context).edit().putStringSet(KEY_HOST_OPERATIONS + hostId, changed).apply()
+    }
+
     /** Material You wallpaper colors; off by default so the designed scheme appears. */
     fun dynamicColor(context: Context): Boolean =
         prefs(context).getBoolean(KEY_DYNAMIC_COLOR, false)
