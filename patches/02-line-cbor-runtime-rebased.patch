+/// Unknown keys, duplicate keys, versions and damaged values deny trust.
+fn encode_record(rec: &DeviceRecord) -> String {
+    use rba_protocol::cbor::Value;
+    rba_protocol::line::encode_cbor_line(&Value::map([
+        ("v", Value::Uint(1)),
+        ("device_id", Value::Text(rec.device_id.clone())),
+        ("name", Value::Text(rec.name.clone())),
+        ("public_key", Value::Text(rec.public_key.clone())),
+        ("status", Value::Text(rec.status.as_str().into())),
+        ("added_at", Value::Uint(rec.added_at)),
+        ("last_seen", Value::Uint(rec.last_seen.unwrap_or(0))),
+        ("auth_count", Value::Uint(rec.auth_count)),
+        ("users", Value::Array(rec.policy.users.iter().cloned().map(Value::Text).collect())),
+        ("allow_root", Value::Bool(rec.policy.allow_root)),
+        ("revocation_token_hash", Value::Text(rec.revocation_token_hash.clone().unwrap_or_default())),
+    ]))
+}
+fn decode_record(raw: &str) -> Option<DeviceRecord> {
+    use rba_protocol::cbor::Value;
+    let value = rba_protocol::line::decode_cbor_line(raw)?;
+    let Value::Map(ref kv) = value else { return None; };
+    if kv.len() != 11 || value.get("v")?.as_uint()? != 1 { return None; }
+    let text = |key: &str| value.get(key).and_then(Value::as_text).map(str::to_owned);
+    let uint = |key: &str| value.get(key).and_then(Value::as_uint);
+    let device_id = text("device_id")?;
+    let name = text("name")?;
+    let public_key = text("public_key")?;
+    let status = match text("status")?.as_str() {
+        "paired" => DeviceStatus::Paired, "pairing" => DeviceStatus::Pairing,
+        "revoked" => DeviceStatus::Revoked, "replaced" => DeviceStatus::Replaced,
+        _ => return None,
+    };
+    let added_at = uint("added_at")?;
+    let last_seen = match uint("last_seen")? { 0 => None, n => Some(n) };
+    let auth_count = uint("auth_count")?;
+    let users = match value.get("users")? {
+        Value::Array(a) => a.iter().map(|u| u.as_text().map(str::to_owned)).collect::<Option<Vec<_>>>()?,
+        _ => return None,
+    };
+    if users.iter().any(|u| u.is_empty() || u.contains('/') || u.contains(' ')) { return None; }
+    let allow_root = value.get("allow_root")?.as_bool()?;
+    let revocation_token_hash = match text("revocation_token_hash")? {
+        v if v.is_empty() => None, v => Some(v),
+    };
+    Some(DeviceRecord { device_id, name, public_key, added_at, last_seen, status,
+        policy: DevicePolicy { users, allow_root }, revocation_token_hash, auth_count })
 }
 
