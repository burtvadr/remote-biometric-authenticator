index 0000000..54640ca
--- /dev/null
+++ b/linux/protocol/src/line.rs
@@ -0,0 +1,84 @@
+//! Human-readable line-oriented state codec. No JSON or permissive fallback.
+use std::collections::BTreeMap;
+
+pub fn escape(s: &str) -> String {
+    let mut out = String::new();
+    for c in s.chars() {
+        match c {
+            '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '=' => out.push_str("\\="),
+            _ => out.push(c),
+        }
+    }
+    out
+}
+pub fn unescape(s: &str) -> Option<String> {
+    let mut out = String::new();
+    let mut it = s.chars();
+    while let Some(c) = it.next() {
+        if c == '\\' {
+            out.push(match it.next()? {
+                'n' => '\n', 'r' => '\r', '=' => '=', '\\' => '\\', _ => return None,
+            });
+        } else if c == '\n' || c == '\r' { return None; }
+        else { out.push(c); }
+    }
+    Some(out)
+}
+pub fn write(entries: &[(&str, String)]) -> String {
+    let mut out = String::new();
+    for (key, value) in entries { out.push_str(key); out.push('='); out.push_str(&escape(value)); out.push('\n'); }
+    out
+}
+pub fn parse(s: &str) -> Option<BTreeMap<String, String>> {
+    let mut out = BTreeMap::new();
+    for line in s.lines() {
+        let (key, val) = line.split_once('=')?;
+        if key.is_empty() || !key.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'_') { return None; }
+        if out.insert(key.to_string(), unescape(val)?).is_some() { return None; }
+    }
+    Some(out)
+}
+#[cfg(test)] mod tests {
+    use super::*;
+    #[test] fn escape_roundtrip_and_bad_sequences() {
+        let s = "x\n=\\y";
+        assert_eq!(unescape(&escape(s)).unwrap(), s);
+        assert!(unescape("bad\\z").is_none());
+        assert!(parse("version=1\nversion=1\n").is_none());
+    }
+}
+
+/// One canonical CBOR record per ASCII line, lowercase hex encoded so that
+/// arbitrary CBOR bytes (including 0x0a) can never split or splice records.
+/// A record ends with exactly one '\n' on disk/on the control socket.
+pub fn encode_cbor_line(value: &crate::cbor::Value) -> String {
+    let mut line = hex::encode(crate::cbor::encode(value));
+    line.push('\n');
+    line
+}
+
+pub fn decode_cbor_line(line: &str) -> Option<crate::cbor::Value> {
+    let body = line.strip_suffix('\n')?;
+    if body.is_empty() || body.len() % 2 != 0
+        || !body.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()) {
+        return None;
+    }
+    crate::cbor::decode_canonical(&hex::decode(body).ok()?).ok()
+}
+
+#[cfg(test)] mod cbor_line_tests {
+    use super::*;
+    use crate::cbor::Value;
+    #[test] fn canonical_lines_are_strict() {
+        let v = Value::map([("a", Value::Text("\n\r=inside".into()))]);
+        let wire = encode_cbor_line(&v);
+        assert_eq!(wire.matches('\n').count(), 1);
+        assert_eq!(decode_cbor_line(&wire), Some(v));
+        assert!(decode_cbor_line(&wire.to_uppercase()).is_none());
+        assert!(decode_cbor_line(wire.trim_end()).is_none());
+        assert!(decode_cbor_line("00\n").is_none());
+    }
+}
