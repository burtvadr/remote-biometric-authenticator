+/** Versioned, session-bound capability advertisement. It never authorizes an operation. */
+data class Capabilities(
+    val sessionId: Id,
+    val endpoint: String,
+    val version: Long = 1L,
+    val operations: List<String>,
+    val required: List<String> = emptyList(),
+) {
+    fun toPayload(): ByteArray = Cbor.encode(Cbor.ofMap(
+        "version" to Cbor.uint(version),
+        "session_id" to Cbor.bytes(sessionId.bytes),
+        "endpoint" to Cbor.text(endpoint),
+        "operations" to Cbor.Value.Arr(operations.map(Cbor::text)),
+        "required" to Cbor.Value.Arr(required.map(Cbor::text)),
+    ))
+    companion object {
+        val known = setOf("authenticate", "login", "sudo", "polkit", "unlock")
+        fun fromPayload(payload: ByteArray): Capabilities {
+            val v = Cbor.decode(payload) as? Cbor.Value.Map
+                ?: throw ProtocolException(ErrorCode.BAD_REQUEST, "capabilities not a map")
+            val version = (v["version"] as? Cbor.Value.Uint)?.value
+                ?: throw ProtocolException(ErrorCode.BAD_REQUEST, "missing version")
+            if (version != 1L) throw ProtocolException(ErrorCode.UNSUPPORTED_VERSION, "capabilities version")
+            fun list(key: String): List<String> {
+                val items = (v[key] as? Cbor.Value.Arr)?.items
+                    ?: throw ProtocolException(ErrorCode.BAD_REQUEST, "missing $key")
+                if (items.size > 32) throw ProtocolException(ErrorCode.BAD_REQUEST, "too many capabilities")
+                val values = items.map { (it as? Cbor.Value.Text)?.value
+                    ?: throw ProtocolException(ErrorCode.BAD_REQUEST, "bad $key") }
+                if (values.any { it.isEmpty() || it.length > 64 } || values.distinct().size != values.size)
+                    throw ProtocolException(ErrorCode.BAD_REQUEST, "bad $key")
+                return values
+            }
+            val endpoint = (v["endpoint"] as? Cbor.Value.Text)?.value ?: ""
+            if (endpoint !in listOf("host", "device")) throw ProtocolException(ErrorCode.BAD_REQUEST, "bad endpoint")
+            return Capabilities(Id((v["session_id"] as? Cbor.Value.Bytes)?.value
+                ?: throw ProtocolException(ErrorCode.BAD_REQUEST, "missing session id")),
+                endpoint, version, list("operations"), list("required"))
+        }
+    }
+}
