diff --git a/linux/protocol/src/capabilities.rs b/linux/protocol/src/capabilities.rs
new file mode 100644
index 0000000..b6bcccc
--- /dev/null
+++ b/linux/protocol/src/capabilities.rs
@@ -0,0 +1,114 @@
+//! Capability protocol v1. Advertisements never grant authorization.
+//! The transport must be an authenticated SESSION_HELLO connection; the
+//! session identifier prevents messages from being replayed on a new link.
+use std::collections::BTreeSet;
+use crate::cbor::{self, Value};
+use crate::errors::{ProtocolError, Result};
+use crate::types::Id;
+
+pub const VERSION: u64 = 1;
+pub const KNOWN_OPERATIONS: &[&str] = &["authenticate", "login", "sudo", "polkit", "unlock"];
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Capabilities {
+    pub session_id: Id,
+    pub endpoint: String,
+    pub version: u64,
+    pub operations: Vec<String>,
+    pub required: Vec<String>,
+}
+
+impl Capabilities {
+    pub fn offer(session_id: Id, endpoint: &str, operations: &[&str]) -> Self {
+        Self { session_id, endpoint: endpoint.into(), version: VERSION,
+            operations: operations.iter().map(|s| (*s).into()).collect(), required: vec![] }
+    }
+    pub fn to_payload(&self) -> Vec<u8> {
+        cbor::encode(&Value::map([
+            ("version", Value::Uint(self.version)),
+            ("session_id", Value::Bytes(self.session_id.0.to_vec())),
+            ("endpoint", Value::Text(self.endpoint.clone())),
+            ("operations", Value::Array(self.operations.iter().cloned().map(Value::Text).collect())),
+            ("required", Value::Array(self.required.iter().cloned().map(Value::Text).collect())),
+        ]))
+    }
+    pub fn from_payload(bytes: &[u8]) -> Result<Self> {
+        let v = cbor::decode_canonical(bytes).map_err(|e| ProtocolError::BadRequest(format!("capabilities: {e}")))?;
+        let get_text = |key: &str| -> Result<String> { v.get(key).and_then(Value::as_text)
+            .map(str::to_owned).ok_or_else(|| ProtocolError::BadRequest(format!("capabilities: missing {key}"))) };
+        let get_array = |key: &str| -> Result<Vec<String>> {
+            match v.get(key) {
+                Some(Value::Array(a)) if a.len() <= 32 => a.iter().map(|x| x.as_text()
+                    .filter(|s| !s.is_empty() && s.len() <= 64)
+                    .map(str::to_owned)
+                    .ok_or_else(|| ProtocolError::BadRequest(format!("capabilities: bad {key}")))).collect(),
+                _ => Err(ProtocolError::BadRequest(format!("capabilities: missing/bad {key}"))),
+            }
+        };
+        let version = v.get("version").and_then(Value::as_uint)
+            .ok_or_else(|| ProtocolError::BadRequest("capabilities: missing version".into()))?;
+        if version != VERSION { return Err(ProtocolError::UnsupportedVersion(version.min(255) as u8)); }
+        let session_id = Id::from_slice(v.get("session_id").and_then(Value::as_bytes)
+            .ok_or_else(|| ProtocolError::BadRequest("capabilities: missing session_id".into()))?)?;
+        let cap = Self { session_id, endpoint: get_text("endpoint")?, version,
+            operations: get_array("operations")?, required: get_array("required")? };
+        if !matches!(cap.endpoint.as_str(), "host" | "device") {
+            return Err(ProtocolError::BadRequest("capabilities: invalid endpoint".into()));
+        }
+        if cap.operations.iter().collect::<BTreeSet<_>>().len() != cap.operations.len()
+            || cap.required.iter().collect::<BTreeSet<_>>().len() != cap.required.len() {
+            return Err(ProtocolError::BadRequest("capabilities: duplicate item".into()));
+        }
+        Ok(cap)
+    }
+    /// Host and device capabilities intersect with both policy layers. Unknown
+    /// required items and missing required operations fail closed.
+    pub fn negotiate(&self, device: &Self, host_policy: &[&str], device_policy: &[&str]) -> Result<Vec<String>> {
+        if self.endpoint != "host" || device.endpoint != "device" || self.session_id != device.session_id {
+            return Err(ProtocolError::ContextMismatch("capability endpoint/session mismatch".into()));
+        }
+        for item in self.required.iter().chain(device.required.iter()) {
+            if !KNOWN_OPERATIONS.contains(&item.as_str())
+                || !self.operations.contains(item) || !device.operations.contains(item) {
+                return Err(ProtocolError::ContextMismatch(format!("required capability unavailable: {item}")));
+            }
+        }
+        Ok(self.operations.iter().filter(|op| KNOWN_OPERATIONS.contains(&op.as_str())
+            && device.operations.contains(op) && host_policy.contains(&op.as_str())
+            && device_policy.contains(&op.as_str())).cloned().collect())
+    }
+    /// A capability change is never implicitly accepted after negotiation.
+    pub fn unchanged(&self, newer: &Self) -> Result<()> {
+        if self != newer { return Err(ProtocolError::ContextMismatch("capability downgrade or change requires a new session".into())); }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test] fn canonical_roundtrip() {
+        let v = Capabilities::offer(Id::default(), "host", &["login", "sudo"]);
+        assert_eq!(Capabilities::from_payload(&v.to_payload()).unwrap(), v);
+    }
+    #[test] fn intersection_and_toggles_never_grant() {
+        let s = Id::default();
+        let host = Capabilities::offer(s, "host", &["login", "sudo", "polkit"]);
+        let dev = Capabilities::offer(s, "device", &["login", "sudo", "polkit"]);
+        assert_eq!(host.negotiate(&dev, &["login", "sudo"], &["login", "polkit"]).unwrap(), vec!["login"]);
+    }
+    #[test] fn downgrade_required_and_session_mismatch_fail_closed() {
+        let s = Id::default();
+        let mut host = Capabilities::offer(s, "host", &["login", "sudo"]);
+        let mut dev = Capabilities::offer(s, "device", &["login"]);
+        host.required.push("sudo".into());
+        assert!(host.negotiate(&dev, &["login", "sudo"], &["login"]).is_err());
+        host.required.clear();
+        dev.required.push("unknown".into());
+        assert!(host.negotiate(&dev, &["login"], &["login"]).is_err());
+        dev.required.clear();
+        assert!(host.unchanged(&Capabilities::offer(s, "host", &["login"])).is_err());
+        dev.session_id = Id::from_slice(&[3; 16]).unwrap();
+        assert!(host.negotiate(&dev, &["login"], &["login"]).is_err());
+    }
+}
