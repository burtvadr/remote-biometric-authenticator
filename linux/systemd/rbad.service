[Unit]
Description=Remote Biometric Authenticator daemon
Documentation=man:rbad(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Binding the LAN is an explicit deployment choice; the daemon itself defaults to
# loopback. Restrict the port to your LAN with a firewall (or use a specific
# interface address) rather than exposing it to untrusted networks.
ExecStart=/usr/libexec/rbad --host-name %H --bind 0.0.0.0:47123
ExecReload=/bin/kill -HUP $MAINPID

# The daemon verifies signatures and enforces policy. It needs no privilege beyond
# reading its own state directory and creating its socket, so it runs unprivileged.
User=rba
Group=rba
StateDirectory=rba
RuntimeDirectory=rba
LogsDirectory=rba

# The socket is created before privileges are dropped so its group ownership is
# correct from the moment it exists.
SupplementaryGroups=rba

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
CapabilityBoundingSet=
AmbientCapabilities=

# State and logs must be writable; everything else is read-only.
ReadWritePaths=/var/lib/rba /var/log/rba

[Install]
WantedBy=multi-user.target
